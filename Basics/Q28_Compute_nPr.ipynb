   "source": [
    "def fact(n: int) -> int:\n",
    "    result = 1\n",
    "    for i in range(2, n + 1):\n",
    "        result *= i\n",
    "    return result\n",
    "\n",
    "def nPr(n: int, r: int) -> int:\n",
    "    return fact(n) // fact(n - r)\n",
    "\n",
    "n = 5\n",
    "r = 2\n",
    "\n",
    "print(nPr(n, r))"
   ]
  }
 ],
