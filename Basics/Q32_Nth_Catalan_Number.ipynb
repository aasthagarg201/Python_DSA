   "source": [
    "Finding nth catalan number"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "363cbe77-d612-4191-a153-9819b5181743",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "5\n"
     ]
    }
   ],
   "source": [
    "def findCatalan(n):\n",
    "    if n <= 1:\n",
    "        return 1\n",
    "    res = 0\n",
    "    for i in range(n):\n",
    "        res += findCatalan(i) * findCatalan(n - i - 1)\n",
    "\n",
    "    return res\n",
    "\n",
    "n = 3\n",
    "res = findCatalan(n)\n",
    "print(res)"
   ]
  }
 ],
