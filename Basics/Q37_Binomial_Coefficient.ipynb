   "source": [
    "Given an integer values n and k,finding the value of Binomial Coefficient C(n, k)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "2219d528-687a-49c9-8ad3-5edcf4bbf773",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "10\n"
     ]
    }
   ],
   "source": [
    "def binomialCoeff(n, k):\n",
    "    if k > n:\n",
    "        return 0\n",
    "    if k == 0 or k == n:\n",
    "        return 1\n",
    "    return binomialCoeff(n - 1, k - 1) + binomialCoeff(n - 1, k)\n",
    "\n",
    "n = 5\n",
    "k = 2\n",
    "print(binomialCoeff(n, k))"
   ]
  }
 ],
