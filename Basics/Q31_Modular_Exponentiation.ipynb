   "source": [
    "Modular Exponentiation (Power in Modular Arithmetic)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "0c6fea2c-1dba-4b8d-aeb0-0dbafeb618b8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1\n"
     ]
    }
   ],
   "source": [
    "def powMod(x, n, M):\n",
    "    res = 1\n",
    "    for i in range(n):\n",
    "        res = (res * x) % M\n",
    "    return res\n",
    "\n",
    "x, n, M = 3, 2, 4\n",
    "print(powMod(x, n, M))"
   ]
  }
 ],
