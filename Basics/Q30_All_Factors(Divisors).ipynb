   "source": [
    "Calculating all the divisors of a number"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "f5f0e16c-64dc-43c8-9453-f5a6855d47db",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1 2 5 10 "
     ]
    }
   ],
   "source": [
    "def getDivisors(n):\n",
    "    divisors = []\n",
    "    for i in range(1, n + 1):\n",
    "        if n % i == 0:\n",
    "            divisors.append(i)\n",
    "\n",
    "    return divisors\n",
    "    \n",
    "n = 10\n",
    "divisors = getDivisors(n)\n",
    "for div in divisors:\n",
    "    print(div, end=\" \")"
   ]
  }
 ],
