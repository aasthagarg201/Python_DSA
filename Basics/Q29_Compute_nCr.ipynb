   ],
   "source": [
    "def nCr(n, r):\n",
    "    if r > n:  \n",
    "        return 0\n",
    "        \n",
    "    if r == 0 or r == n:  \n",
    "        return 1\n",
    "    return nCr(n - 1, r - 1) + nCr(n - 1, r)\n",
    "\n",
    "\n",
    "n = 5\n",
    "r = 2\n",
    "print(nCr(n, r))"
   ]
  }
 ],
