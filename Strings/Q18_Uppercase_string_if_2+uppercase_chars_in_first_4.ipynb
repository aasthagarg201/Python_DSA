   "source": [
    "Uppercase string if 2+ uppercase chars in first 4"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "be7f3553-135f-47e3-aa57-8bd3db23c55c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Python\n",
      "PYTHON\n"
     ]
    }
   ],
   "source": [
    "def to_uppercase(str1):\n",
    "    num_upper = 0\n",
    "    for letter in str1[:4]:\n",
    "        if letter.upper() == letter:\n",
    "            num_upper += 1\n",
    "    if num_upper >= 2:\n",
    "        return str1.upper()\n",
    "    return str1\n",
    "\n",
    "print(to_uppercase('Python'))  \n",
    "print(to_uppercase('PyThon'))  "
   ]
  }
 ],
