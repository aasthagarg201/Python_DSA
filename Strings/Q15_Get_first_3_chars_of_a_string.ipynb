   "source": [
    "Get first 3 chars of a string"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "fa10949c-2c7f-49da-a63f-ee092c0d1790",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ipy\n",
      "pyt\n",
      "py\n"
     ]
    }
   ],
   "source": [
    "def first_three(str):\n",
    "    if len(str) > 3:\n",
    "        return str[:3]\n",
    "    else:\n",
    "        return str\n",
    "\n",
    "print(first_three('ipyx'))     \n",
    "print(first_three('python'))   \n",
    "print(first_three('py'))     \n"
   ]
  },
