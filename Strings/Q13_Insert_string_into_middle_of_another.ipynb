    "print(insert_str('[[]]', 'Python')) \n",
    "print(insert_str('{{}}', 'PHP'))\n",
    "print(insert_str('<<>>', 'HTML'))    \n",
    "print(insert_str('Pyon', 'th'))"
   ]
  }
