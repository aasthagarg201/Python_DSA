   "source": [
    "Wrap word(s) in HTML tags"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "36cc9173-d647-493a-b410-54d4a5665fcd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "<i>Python</i>\n",
      "<b>Python Tutorial</b>\n"
     ]
    }
   ],
   "source": [
    "def add_tags(tag, word):\n",
    "    return \"<%s>%s</%s>\" % (tag, word, tag)\n",
    "     \n",
    "print(add_tags('i', 'Python'))\n",
    "\n",
    "print(add_tags('b', 'Python Tutorial'))"
   ]
  }
 ],
